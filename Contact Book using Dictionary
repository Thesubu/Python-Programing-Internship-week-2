contacts = {}

def contact_book():
    while True:
        print("\n--- Contact Book ---")
        print("1. Add Contact\n2. Search Contact\n3. Update Contact\n4. Delete Contact\n5. Exit")
        choice = input("Enter choice (1-5): ").strip()
        
        if choice == '1':
            name = input("Enter name: ").strip()
            phone = input("Enter phone number: ").strip()
            contacts[name] = phone
            print(f"Contact '{name}' added successfully.")
        elif choice == '2':
            name = input("Enter name to search: ").strip()
            print(f"Phone: {contacts[name]}" if name in contacts else "Contact not found.")
        elif choice == '3':
            name = input("Enter name to update: ").strip()
            if name in contacts:
                contacts[name] = input("Enter new phone number: ").strip()
                print("Contact updated successfully.")
            else:
                print("Contact not found.")
        elif choice == '4':
            name = input("Enter name to delete: ").strip()
            if contacts.pop(name, None):
                print("Contact deleted successfully.")
            else:
                print("Contact not found.")
        elif choice == '5':
            break
        else:
            print("Invalid choice. Try again.")

if __name__ == "__main__":
    contact_book()
